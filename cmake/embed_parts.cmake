# Compiles data files into a C array so every build (desktop, web, mobile)
# carries them without files on disk.
#   cmake -DOUT=<file.c> -DIN="<a.txt;b.txt>" [-DSYMBOL=name] -P embed_parts.cmake
# Each input is preceded by a "@file <name>" line so the reader can tell the
# files apart (parts library, translation packs).
if(NOT DEFINED SYMBOL OR SYMBOL STREQUAL "")
  set(SYMBOL de_partdata)
endif()
set(data "")
foreach(f ${IN})
  get_filename_component(name ${f} NAME)
  file(READ ${f} body)
  string(APPEND data "@file ${name}\n${body}\n")
endforeach()
string(LENGTH "${data}" len)
file(WRITE ${OUT}.tmp "${data}")
file(READ ${OUT}.tmp hex HEX)
file(REMOVE ${OUT}.tmp)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
file(WRITE ${OUT} "/* generated by cmake/embed_parts.cmake */\n"
  "const unsigned char ${SYMBOL}[] = {\n${hex}0x00};\n"
  "const unsigned long ${SYMBOL}_size = sizeof(${SYMBOL}) - 1;\n")
